# FP AUTO Pvt. Ltd. - Flipkart Auto-Listing Configuration

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/parth_plasto_pack

# Next.js App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-Side Encryption Key (Must be 32 bytes / 64 hex characters for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Flipkart Seller/Marketplace API Credentials (Official OAuth 2.0)
# Obtain these from Flipkart Seller Hub Developer Portal
FLIPKART_CLIENT_ID=your_flipkart_app_app_id
FLIPKART_CLIENT_SECRET=your_flipkart_app_app_secret
FLIPKART_REDIRECT_URI=http://localhost:3000/api/flipkart/callback
FLIPKART_API_BASE_URL=https://api.flipkart.net
FLIPKART_ENVIRONMENT=sandbox # "sandbox" or "production"

# Cron Security Secret for Scheduled Background Sync
CRON_SECRET=parth_plasto_cron_secret_key_2026

# AI Engine Key (Gemini API or OpenAI API) for Intelligent Listing Generation
# Server-side only
GEMINI_API_KEY=
